{
	"name": "@apreal/server",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"dev": "node --watch --conditions=development --import tsx src/index.ts --home ~/.apreal-dev",
		"start": "node --conditions=development --import tsx src/index.ts --home ~/.apreal-dev",
		"build": "pnpm typecheck && node scripts/build-release.mjs",
		"typecheck": "tsc --noEmit",
		"test": "node --conditions=development --import tsx --test src/tests/*.test.ts"
	},
	"dependencies": {
		"@apreal/shared": "workspace:*",
		"@earendil-works/pi-ai": "^0.80.6",
		"@earendil-works/pi-coding-agent": "^0.80.6",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"open-computer-use": "0.2.0",
		"smol-toml": "^1.7.0",
		"ws": "^8.21.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/ws": "^8.18.1",
		"esbuild": "0.28.0",
		"typescript": "^5.9.3"
	}
}
